# MycoFilter 2.0 — Environment Variables
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Leave blank to run in demo/simulated mode (no hardware, no database).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: service-role key for admin operations (migrations, RLS bypass).
# NEVER expose this in client code or NEXT_PUBLIC_ vars.
SUPABASE_SERVICE_ROLE_KEY=

# ─── MQTT (optional — for hardware integration) ────────────────────────────────
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=mycofilter/

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development
